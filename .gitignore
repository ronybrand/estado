build/
.gradle/
.classpath
.project
.settings/

# Segredo real nunca vai pro repo (POSTGRES_PASSWORD, tokens do Grafana Cloud
# etc.) - so o .env.example, template sem valor real, fica versionado.
.env
.env.compose

# Conteudo das skills baixado pelo Claude Code a partir do skills-lock.json
# (hash pinado por skill) - regeneravel, nao precisa ficar versionado, igual
# node_modules pro package-lock.json. O skills-lock.json em si fica versionado.
.claude/skills/
.claude/settings.local.json

# Mesmo espelho de skills baixadas, de outra ferramenta de agente - tambem
# regeneravel, sem lockfile proprio pra preservar.
.agents/

# Config de IDE local (VSCode/JetBrains) - preferencia por maquina, sem
# valor compartilhado num projeto sem outros colaboradores.
.vscode/
.idea/

# Saidas de build/IDE que nao sao do Gradle: bin/ (Eclipse) e target/ (resto do
# tempo em que o build era Maven, ADR 0019). O build real vai em build/.
/bin/
/target/

# Rascunhos locais (scripts descartaveis, testes de ferramenta) - nao fazem parte
# do projeto.
/.scratch-*/
/scratch_*
