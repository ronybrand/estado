// Coleta metricas de host (disco, memoria, CPU) e logs dos containers Docker,
// empurra direto pra Grafana Cloud via remote_write/loki.write - nenhuma
// chamada a API da AWS, custo incremental na AWS fica em zero. Ver ADR 0012.
//
// Requer no ambiente (via EnvironmentFile do systemd, ver deploy/README.md):
// GRAFANA_CLOUD_PROMETHEUS_URL, GRAFANA_CLOUD_INSTANCE_ID,
// GRAFANA_CLOUD_LOKI_URL, GRAFANA_CLOUD_LOKI_INSTANCE_ID, GRAFANA_CLOUD_API_KEY
//
// O usuario "alloy" (criado pelo pacote) precisa estar no grupo "docker" pra
// ler /var/run/docker.sock - ver deploy/README.md. Mesmo trade-off que o
// ec2-user ja tem: grupo docker e root-equivalente no host.

prometheus.exporter.unix "host" {
  enable_collectors = ["meminfo", "filesystem", "cpu", "loadavg"]

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
  }
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "instance"
    replacement  = "estado-portfolio"
  }

  rule {
    target_label = "job"
    replacement  = "integrations/node_exporter"
  }
}

prometheus.scrape "host" {
  scrape_interval = "60s"
  targets         = discovery.relabel.host.output
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_INSTANCE_ID")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// Metricas da app (JVM, HTTP por endpoint/status, pool de conexao) via
// /actuator/prometheus. O container estado-app NAO publica a porta 8080 pro
// host de proposito - so vive nas redes Docker internas (estado_internal,
// portfolio) - porque publicar pro host quebraria o rolling swap sem downtime
// (ADR 0005): container antigo e novo coexistem por ate 60s durante o health
// check, e dois containers nao podem publicar a mesma porta do host ao mesmo
// tempo. Em vez disso, descobre o IP interno do container dinamicamente via
// Docker (mesmo mecanismo do discovery.docker acima) - sobrevive a cada
// rolling swap sem reconfigurar nada, sem abrir porta nova.
discovery.relabel "estado_app_metrics" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "^/estado-app$"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_network_ip"]
    regex         = "(.+)"
    target_label  = "__address__"
    replacement   = "${1}:8080"
  }

  rule {
    target_label = "job"
    replacement  = "estado-app"
  }
}

prometheus.scrape "estado_app" {
  scrape_interval = "60s"
  metrics_path    = "/actuator/prometheus"
  targets         = discovery.relabel.estado_app_metrics.output
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.grafana_cloud.receiver]
}

// backup.sh/deploy.sh/prune.sh rodam via systemd direto no host, nao em
// container - loki.source.docker acima nao ve esses logs. Filtrado so pras 3
// units que interessam (nao o journal inteiro do host: kernel/sshd/cloud-init
// seriam ruido). Sintaxe do relabel_rules nao validada contra uma instancia
// real (SSH bloqueado nesta sessao) - conferir via `journalctl -u alloy`
// depois de instalado, mesma ressalva do resto deste arquivo.
discovery.relabel "systemd_units" {
  targets = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "estado-(backup|deploy|prune)\\.service"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "systemd_units" {
  relabel_rules = discovery.relabel.systemd_units.rules
  labels        = {job = "integrations/systemd-journal"}
  forward_to    = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_INSTANCE_ID")
      password = sys.env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
