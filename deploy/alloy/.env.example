# Copiar para ~/alloy/.env na instancia (chmod 600) e preencher com os valores
# reais do seu stack Grafana Cloud (Connections > Add new connection > Hosted
# Prometheus metrics / Hosted Logs pra pegar URL e instance ID de cada um,
# Access Policies pra gerar UM token com escopo metrics:write + logs:write).
# O .env real NUNCA vai pro repo - fica so na instancia e no Bitwarden (ver
# ADR 0012).

GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-region.grafana.net/api/prom/push
GRAFANA_CLOUD_INSTANCE_ID=changeme-seu-stack-id-prometheus
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_INSTANCE_ID=changeme-seu-stack-id-loki
GRAFANA_CLOUD_API_KEY=changeme-api-token-escopo-metrics-write-logs-write
