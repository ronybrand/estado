# Copiar para ~/estado/.env na instância (chmod 600) e preencher com valores
# reais. O .env real NUNCA vai pro repo — segredo fica só na instância e no
# Bitwarden (ver Fase 3 do plano de deploy).
#
# POSTGRES_DB/POSTGRES_USER não são variáveis — vêm fixos como "estado" no
# docker-compose.yml e nos scripts (nome de banco/usuário não é segredo).

POSTGRES_PASSWORD=changeme-32-chars-aleatorios

# Sem barra final — usado por comparação exata no CORS (ver Bug 3 no plano de deploy)
API_ORIGIN_PERMITIDA=https://54.94.231.248.sslip.io
