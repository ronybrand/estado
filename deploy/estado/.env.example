# Copiar para ~/estado/.env na instância (chmod 600) e preencher com valores
# reais. O .env real NUNCA vai pro repo — segredo fica só na instância e no
# Bitwarden (ver Fase 3 do plano de deploy).
#
# POSTGRES_DB/POSTGRES_USER não são variáveis — vêm fixos como "estado" no
# docker-compose.yml e nos scripts (nome de banco/usuário não é segredo).

POSTGRES_PASSWORD=changeme-32-chars-aleatorios

# Sem barra final — usado por comparação exata no CORS (ver Bug 3 no plano de deploy)
API_ORIGIN_PERMITIDA=https://54.94.231.248.sslip.io

# Anotação de deploy/rollback no Grafana (ver ADR 0012) — opcional: se
# ausente, deploy.sh/rollback.sh simplesmente não anotam, sem falhar.
# GRAFANA_CLOUD_URL é a URL do próprio Grafana (ex: https://seustack.grafana.net),
# diferente da URL de push do Prometheus/Loki em deploy/alloy/.env.
# GRAFANA_CLOUD_ANNOTATIONS_TOKEN é um Service Account token com permissão
# de escrita em anotações (Grafana Cloud > Administration > Service accounts).
GRAFANA_CLOUD_URL=https://changeme.grafana.net
GRAFANA_CLOUD_ANNOTATIONS_TOKEN=changeme-service-account-token
