# Copiar para ~/estado/.env na instância (chmod 600) e preencher com valores
# reais. O .env real NUNCA vai pro repo — segredo fica só na instância e no
# Bitwarden (ver Fase 3 do plano de deploy).
#
# POSTGRES_DB/POSTGRES_USER não são variáveis — vêm fixos como "estado" no
# docker-compose.yml e nos scripts (nome de banco/usuário não é segredo).

POSTGRES_PASSWORD=changeme-32-chars-aleatorios

# Sem barra final — usado por comparação exata no CORS (ver Bug 3 no plano de deploy)
API_ORIGIN_PERMITIDA=https://54.94.231.248.sslip.io

# Autenticação JWT, usuário admin único, sem tabela de usuários (ver ADR 0017).
# ADMIN_PASSWORD_HASH é o hash BCrypt da senha (gerar com um
# BCryptPasswordEncoder ad-hoc — nunca a senha em texto plano). O valor abaixo
# é o hash da credencial de demonstração documentada no README
# (admin / Estado-Demo-2026) — intencionalmente pública, ver README. Troque
# por um hash próprio se quiser uma instância privada.
# ATENÇÃO: deploy.sh carrega este arquivo com "source" (bash), não um parser
# de .env — todo "$" no valor é expandido como variável de shell antes de
# chegar no container (ex: "$2a$10$..." vira lixo, já quebrou em produção).
# Escape cada "$" como "\$" (veja o valor abaixo) sempre que gerar um hash novo.
# JWT_SECRET assina/valida o token — 32+ bytes aleatórios (ex: openssl rand -base64 48).
# Esse sim precisa ficar secreto mesmo com login público: quem tiver o
# JWT_SECRET forja tokens válidos sem precisar da senha. Não tem "$" no
# alfabeto do base64 padrão, então não sofre do mesmo problema.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=\$2a\$10\$7uQUkrPri9L7sGlnSlaWdOFWqxXWohPCmt4/PVGxeXvZb6nkiC4ri
JWT_SECRET=changeme-segredo-aleatorio-longo

# BFF pro estado-ai-agent (POST /ask) — guarda a key server-side, nunca no
# frontend (ver AskProxyService/AskProxyController). ASK_API_KEY precisa
# bater com a mesma variável no .env do estado-ai-agent. ASK_API_BASE_URL
# aponta pra rede Docker interna (estado_internal), não pra URL pública — o
# estado-ai-agent não é mais exposto pelo Caddy de propósito (ver Caddyfile).
ASK_API_KEY=changeme-segredo-aleatorio-longo
ASK_API_BASE_URL=http://estado-ai-agent-app:8080

# Anotação de deploy/rollback no Grafana (ver ADR 0012) — opcional: se
# ausente, deploy.sh/rollback.sh simplesmente não anotam, sem falhar.
# GRAFANA_CLOUD_URL é a URL do próprio Grafana (ex: https://seustack.grafana.net),
# diferente da URL de push do Prometheus/Loki em deploy/alloy/.env.
# GRAFANA_CLOUD_ANNOTATIONS_TOKEN é um Service Account token com permissão
# de escrita em anotações (Grafana Cloud > Administration > Service accounts).
GRAFANA_CLOUD_URL=https://changeme.grafana.net
GRAFANA_CLOUD_ANNOTATIONS_TOKEN=changeme-service-account-token
