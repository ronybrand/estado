# Copiar para .env.compose (gitignored) e preencher - usado so pelo
# docker-compose.yml deste repo (ecossistema completo em dev local).

POSTGRES_PASSWORD=estado-local-dev

# Hash BCrypt da senha de admin (ADR 0017) - nunca a senha em texto plano.
# Gerar com (senha "admin123" so como exemplo local - o primeiro argumento
# e so o rotulo que o htpasswd exige, nao precisa bater com admin.username).
# Colar o resultado entre aspas simples: o Compose interpola "$" em valores
# de .env sem aspas e mutilaria o hash ($2y$10$...):
#   docker run --rm httpd:alpine htpasswd -nbB -C 10 admin admin123 | cut -d: -f2
ADMIN_PASSWORD_HASH=''

# Segredo HMAC pra assinar/validar o JWT - qualquer string aleatoria o
# bastante serve em dev local. Gerar com:
#   openssl rand -base64 32
JWT_SECRET=

# Mesmo valor nos dois - e o segredo compartilhado entre o proxy /ask do
# backend e o estado-ai-agent (X-API-Key). Gerar com:
#   openssl rand -base64 32
ASK_API_KEY=

# Chave de API do Google AI Studio (gratuita) para o estado-ai-agent chamar
# o Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# So preencher se os clones de angular_estado/estado-ai-agent NAO ficarem
# como repos irmaos deste (mesmo diretorio pai) - caminho absoluto ou
# relativo a este arquivo. Deixar vazio usa o default (../angular_estado,
# ../estado-ai-agent).
# ANGULAR_ESTADO_PATH=
# ESTADO_AI_AGENT_PATH=
